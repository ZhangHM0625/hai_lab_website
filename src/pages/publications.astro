---
import MainLayout from '../layouts/MainLayout.astro';
import { sanityClient, type Publication } from '../lib/sanity';

const heroBgImage = `${import.meta.env.BASE_URL}/publications-hero.jpg`;

const allPapers = await sanityClient.fetch<Publication[]>(`
  *[_type == "publication"] | order(year desc, _id asc) {
    "id": _id,
    year,
    theme,
    title,
    authors,
    journalInfo,
    "doi": coalesce(doi, ""),
    "url": coalesce(url, ""),
    "abstract": coalesce(abstract, "")
  }
`);

const papersByYear = new Map<string, Publication[]>();
for (const paper of allPapers) {
  const papers = papersByYear.get(paper.year) ?? [];
  papers.push(paper);
  papersByYear.set(paper.year, papers);
}

const publications = Array.from(papersByYear, ([year, papers]) => ({ year, papers }));

const themes = [
  { id: "advertising",  label: "Technologies for Advertising, PR & Journalism" },
  { id: "smartphone",   label: "Smartphone and Mobile Technologies" },
  { id: "hci-theory",   label: "HCI Theories, Concepts and Philosophy" },
  { id: "speech",       label: "Speech User Interface" },
  { id: "social-media", label: "Social Media and Internet" },
  { id: "healthcare",   label: "Healthcare Technology" },
  { id: "robot",        label: "Human Robot Interaction" },
  { id: "education",    label: "Educational Technology" },
  { id: "policy",       label: "Technology Policy and Public Intervention" },
  { id: "games",        label: "Computer Games and Entertainment Technologies" },
  { id: "fintech",      label: "Financial Technology" },
];
---

<MainLayout title="Publications">
  <style>
    @keyframes slideInFromLeft {
      0% { opacity: 0; transform: translateX(-40px); }
      100% { opacity: 1; transform: translateX(0); }
    }

    /* --- Hero --- */
    .pub-hero {
      position: relative; height: 20vh; min-height: 300px;
      display: flex; align-items: center; padding: 0 5%;
      color: white; background-color: #050505; overflow: hidden;
    }
    .pub-hero-bg {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background-size: cover; background-position: center; z-index: 1;
    }
    .pub-hero-content {
      position: relative; z-index: 2; max-width: 1000px;
      margin: 0 auto; width: 100%;
      animation: slideInFromLeft 0.8s ease-out forwards;
    }
    .pub-hero-title {
      font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800;
      margin-bottom: 0.1rem; letter-spacing: -0.01em;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .pub-hero-subtitle {
      font-size: 1.2rem; color: #cbd5e1; font-weight: 400;
      text-shadow: 0 1px 6px rgba(0,0,0,0.5);
    }

    /* --- 内容区 --- */
    .pub-container { max-width: 900px; margin: 60px auto; padding: 0 5%; }

    /* --- 切换按钮 --- */
    .view-toggle { display: flex; gap: 8px; margin-bottom: 40px; }
    .toggle-btn {
      padding: 8px 24px; border-radius: 40px;
      font-size: 0.88rem; font-weight: 600; cursor: pointer;
      border: 1.5px solid #e2e8f0; background: white; color: #475569;
      transition: all 0.2s;
    }
    .toggle-btn.active { background: #0f172a; color: white; border-color: #0f172a; }
    .toggle-btn:hover:not(.active) { border-color: #ce1126; color: #ce1126; }

    /* --- Timeline --- */
    .year-section { margin-bottom: 60px; }
    .year-heading {
      font-size: 2rem; font-weight: 800; color: #003087;
      padding-bottom: 10px; border-bottom: 1px solid #e2e8f0;
      margin-bottom: 20px;
      animation: slideInFromLeft 0.8s ease-out forwards;
    }

    /* --- Theme --- */
    #theme-view { display: none; }
    .theme-section { margin-bottom: 56px; }
    .theme-heading {
      font-size: 1.4rem; font-weight: 800; color: #003087;
      padding-bottom: 10px; border-bottom: 1px solid #e2e8f0;
      margin-bottom: 20px;
      animation: slideInFromLeft 0.8s ease-out forwards;
    }

    /* --- 论文条目 --- */
    .paper-item { margin-bottom: 35px; }
    .paper-title {
      font-size: 1.2rem; font-weight: 600; color: #0f172a;
      display: inline-block; margin-bottom: 10px;
      line-height: 1.5; text-decoration: none;
    }
    .paper-meta { font-size: 1rem; color: #475569; margin-bottom: 10px; line-height: 1.5; }
    .paper-links { display: flex; gap: 15px; margin-bottom: 8px; }
    .btn-link {
      font-size: 0.95rem; font-weight: 700; color: #1e293b;
      text-decoration: none; background: none; border: none;
      padding: 0; cursor: pointer; font-family: inherit;
    }
    .btn-link:hover { color: #ce1126; }
    .abstract-content {
      display: none; font-size: 0.95rem; line-height: 1.6;
      color: #334155; background: #f8fafc;
      padding: 15px 20px; border-left: 2px solid #94a3b8; margin-top: 8px;
    }

    /* --- 响应式 --- */
    @media (max-width: 768px) {
      .pub-hero { height: 8vh; min-height: 180px; padding: 0 5%; }
      .pub-hero-bg { background-position: 100% center; }
      .pub-hero-title { font-size: 1.5rem; margin-bottom: 0.3rem; }
      .pub-hero-subtitle { font-size: 0.95rem; letter-spacing: 0.05em; }
      .pub-container { margin: 36px auto; }
      .year-heading { font-size: 1.4rem; margin-bottom: 16px; padding-bottom: 8px; }
      .theme-heading { font-size: 1.1rem; }
      .paper-item { margin-bottom: 24px; }
      .paper-title { font-size: 1rem; }
      .paper-meta { font-size: 0.88rem; }
      .btn-link { font-size: 0.85rem; }
      .abstract-content { font-size: 0.85rem; padding: 12px 14px; }
      .year-section { margin-bottom: 40px; }
      .view-toggle { margin-bottom: 28px; }
      .toggle-btn { padding: 7px 18px; font-size: 0.82rem; }
    }
    @media (max-width: 480px) {
      .paper-title { font-size: 0.95rem; }
      .paper-meta { font-size: 0.83rem; }
    }
  </style>

  <header class="pub-hero">
    <div class="pub-hero-bg" style={`background-image: linear-gradient(to right, rgba(0,10,30,0.62) 20%, rgba(0,10,30,0.25) 60%, rgba(0,0,0,0.05) 100%), url(${heroBgImage});`}></div>
    <div class="pub-hero-content">
      <h1 class="pub-hero-title">Publications</h1>
      <p class="pub-hero-subtitle">HAIL | Human + AI</p>
    </div>
  </header>

  <main class="pub-container">

    <div class="view-toggle">
      <button class="toggle-btn active" id="timelineBtn">Timeline</button>
      <button class="toggle-btn" id="themeBtn">Theme</button>
    </div>

    <!-- Timeline 视图 -->
    <div id="timeline-view">
      {publications.map((section: any) => (
        <div class="year-section">
          <h2 class="year-heading">{section.year}</h2>
          {section.papers.map((paper: any) => (
            <div class="paper-item">
              <span class="paper-title">{paper.title}</span>
              <p class="paper-meta">
                {paper.authors} ({section.year}). <span set:html={paper.journalInfo}></span>
              </p>
              <div class="paper-links">
                {paper.abstract && (
                  <button class="btn-link abstract-btn" data-target={paper.id}>[Abstract]</button>
                )}
                {(paper.doi || paper.url) && (
                  <a href={paper.doi ? `https://doi.org/${paper.doi}` : paper.url}
                     target="_blank" rel="noopener noreferrer" class="btn-link">[Paper]</a>
                )}
              </div>
              {paper.abstract && (
                <div id={paper.id} class="abstract-content">
                  <span set:html={paper.abstract}></span>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>

    <!-- Theme 视图 -->
    <div id="theme-view">
      {themes.map(theme => {
        const papers = allPapers.filter((p: any) => p.theme === theme.id);
        if (papers.length === 0) return null;
        return (
          <div class="theme-section">
            <h2 class="theme-heading">{theme.label}</h2>
            {papers.map((paper: any) => (
              <div class="paper-item">
                <span class="paper-title">{paper.title}</span>
                <p class="paper-meta">
                  {paper.authors} ({paper.year}). <span set:html={paper.journalInfo}></span>
                </p>
                <div class="paper-links">
                  {paper.abstract && (
                    <button class="btn-link abstract-btn" data-target={paper.id + '-t'}>[Abstract]</button>
                  )}
                  {(paper.doi || paper.url) && (
                    <a href={paper.doi ? `https://doi.org/${paper.doi}` : paper.url}
                       target="_blank" rel="noopener noreferrer" class="btn-link">[Paper]</a>
                  )}
                </div>
                {paper.abstract && (
                  <div id={paper.id + '-t'} class="abstract-content">
                    <span set:html={paper.abstract}></span>
                  </div>
                )}
              </div>
            ))}
          </div>
        );
      })}
    </div>

  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.abstract-btn').forEach(button => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          const abstractDiv = document.getElementById(targetId);
          abstractDiv.style.display = abstractDiv.style.display === 'block' ? 'none' : 'block';
        });
      });

      const timelineBtn  = document.getElementById('timelineBtn');
      const themeBtn     = document.getElementById('themeBtn');
      const timelineView = document.getElementById('timeline-view');
      const themeView    = document.getElementById('theme-view');

      timelineBtn.addEventListener('click', () => {
        timelineView.style.display = 'block';
        themeView.style.display    = 'none';
        timelineBtn.classList.add('active');
        themeBtn.classList.remove('active');
      });

      themeBtn.addEventListener('click', () => {
        timelineView.style.display = 'none';
        themeView.style.display    = 'block';
        themeBtn.classList.add('active');
        timelineBtn.classList.remove('active');
      });
    });
  </script>
</MainLayout>
